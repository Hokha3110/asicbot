# ===============================================
# SECURITY SOLUTION COPILOT - ENVIRONMENT CONFIG
# ===============================================

# Server Config
APP_ENV=production
HOST=0.0.0.0
PORT=8000
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_ADMIN_EMAILS=admin@yourcompany.com
FRONTEND_URL=http://localhost:5173

# Database Config (PostgreSQL for Linux Ubuntu 22.04 / Fallback to SQLite for local)
DATABASE_URL=sqlite:///./security_copilot.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/security_copilot

# Vector Database (ChromaDB Directory)
CHROMA_PERSIST_DIR=./chroma_db

# Storage Directory for Uploaded Docs (Hybrid: Linux Server + Google Drive)
UPLOAD_DIR=./uploaded_docs

# Google Drive Cloud Storage (Optionally sync files with a shared Google Drive folder)
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_FOLDER_ID=your_gdrive_folder_id_here
GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=./service_account.json

# AI Engine Configurations
DEFAULT_LLM_PROVIDER=gemini # Options: gemini, openai, ollama, mock

# Google Gemini Config (Fast & Accurate for Security Presales)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash # Options: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro

# OpenAI Config
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama Local LLM Config (Running on Ubuntu 22.04 or Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Embedding Engine (local sentence-transformers or openai)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# CORS Config (Allow Vercel Frontend Domain)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app
